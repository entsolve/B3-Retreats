# B³ Retreats — Schutz fuer Dateien, die niemand aus dem Netz sehen darf.
#
# Bewusst minimal: hier steht KEIN Rewriting und KEINE Umleitung. Jede Regel
# mehr waere eine Fehlerquelle, die niemand vermutet, wenn spaeter etwas klemmt.

# Die Startseite kommt aus index.php (Vorlage + Datenbank), nicht mehr aus der
# statischen index.html. DIESE ZEILE IST NOETIG, WEIL DAS HOSTING index.html
# ZUERST NIMMT: liegen beide Dateien nebeneinander und fehlt die Zeile, sieht
# die Besucherin weiter die alte, erzeugte Fassung — und im Panel gespeicherte
# Aenderungen tauchen nie auf.
#
# index.html bleibt trotzdem liegen: index.php faellt auf sie zurueck, wenn die
# Vorlage einmal nicht gebaut werden kann.
DirectoryIndex index.php index.html
#
# Der einzige Zweck: config.php enthaelt das Datenbank-Passwort. Solange PHP
# laeuft, liefert der Server sie ohnehin nicht im Klartext aus — aber genau
# dann, wenn PHP einmal aussetzt (Update, falsche Handler-Zuordnung), wuerde
# sie als reine Textdatei im Browser stehen. Diese Sperre gilt auch dann.

<FilesMatch "^(config\.php|config\.example\.php|\.gitignore|.*\.md|.*\.sql|.*\.py|.*\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# content/site.json ist der gesamte Redaktionsinhalt und admin/schema.json die
# Struktur der Oberflaeche. Beides gehoert nicht ins Netz — die fertige Seite
# steht ja in index.html. Der Ausschluss oben trifft sie ueber die Endung .json
# bereits; dieser Block sperrt zusaetzlich die ganzen Ordner.
<IfModule mod_alias.c>
  RedirectMatch 404 ^/(content|tools|db|partials|admin/schema\.json)(/|$)
</IfModule>

# Verzeichnisse ohne index-Datei nicht auflisten.
Options -Indexes
