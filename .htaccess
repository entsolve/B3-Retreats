# B³ Retreats — Schutz fuer Dateien, die niemand aus dem Netz sehen darf.
#
# Bewusst minimal: hier steht KEIN Rewriting und KEINE Umleitung. Jede Regel
# mehr waere eine Fehlerquelle, die niemand vermutet, wenn spaeter etwas klemmt.

# Die Startseite kommt aus index.php (Vorlage + Datenbank), nicht mehr aus der
# statischen index.html. DIESE ZEILE IST NOETIG, WEIL DAS HOSTING index.html
# ZUERST NIMMT: liegen beide Dateien nebeneinander und fehlt die Zeile, sieht
# die Besucherin weiter die alte, erzeugte Fassung — und im Panel gespeicherte
# Aenderungen tauchen nie auf.
#
# index.html bleibt trotzdem liegen: index.php faellt auf sie zurueck, wenn die
# Vorlage einmal nicht gebaut werden kann.
DirectoryIndex index.php index.html
#
# Der einzige Zweck: config.php enthaelt das Datenbank-Passwort. Solange PHP
# laeuft, liefert der Server sie ohnehin nicht im Klartext aus — aber genau
# dann, wenn PHP einmal aussetzt (Update, falsche Handler-Zuordnung), wuerde
# sie als reine Textdatei im Browser stehen. Diese Sperre gilt auch dann.

<FilesMatch "^(config\.php|config\.example\.php|\.gitignore|.*\.md|.*\.sql|.*\.py|.*\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# --- Ins Leere laufende Adressen fuehren zur Startseite --------------------
#
# Eine Seite mit genau einer Adresse braucht keine eigene Fehlerseite: wer
# einen alten Link, einen Tippfehler oder eine geratene Adresse erwischt, soll
# vorne landen statt vor einer Meldung des Servers zu stehen.
#
# ZWEI DINGE, DIE HIER BEWUSST SO STEHEN:
#
#   * Nur was es NICHT gibt, wird umgeleitet (!-f und !-d). Vorhandene Dateien
#     laufen unveraendert weiter — sonst haette die Umleitung Vorrang vor den
#     Sperren weiter unten, und eine gesperrte Datei waere ploetzlich eine
#     Umleitung statt einer Absage.
#   * 302, nicht 301. Eine 301 merkt sich der Browser dauerhaft; taucht die
#     Adresse spaeter doch auf (eine neue Seite, ein neues Bild), zeigt er
#     trotzdem weiter die Startseite, und niemand findet den Grund.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ / [R=302,L]
</IfModule>

# Fuer alles, was die Regel oben nicht erwischt (gesperrte, aber vorhandene
# Dateien), fuehrt derselbe Weg zur Startseite. Die volle Adresse macht daraus
# eine echte Umleitung statt einer Fehlerseite mit fremdem Inhalt.
ErrorDocument 404 https://b3-retreats.de/
ErrorDocument 403 https://b3-retreats.de/

# content/site.json ist der gesamte Redaktionsinhalt und admin/schema.json die
# Struktur der Oberflaeche. Beides gehoert nicht ins Netz — die fertige Seite
# baut index.php daraus. Der Ausschluss oben trifft sie ueber die Endung .json
# bereits; dieser Block sperrt zusaetzlich die ganzen Ordner.
#
# „materials- in" ist NEU in dieser Liste, und zwar nach einem Fund: der Ordner
# mit den Rohunterlagen der Kundin liegt mit auf dem Server, und waehrend das
# Verzeichnis selbst nicht aufgelistet wurde, war die einzelne Datei darin
# ueber ihre volle Adresse abrufbar — die AGB-Vorlage kam mit HTTP 200 heraus.
# Der Ordner gehoert nicht auf einen Webserver; bis er dort verschwindet, ist
# er wenigstens gesperrt. Das Leerzeichen im Namen steht in der Adresse als
# %20, deshalb beide Schreibweisen.
<IfModule mod_alias.c>
  RedirectMatch 404 ^/(content|tools|db|partials|materials-(%20|\s)in|admin/schema\.json)(/|$)
</IfModule>

# Guertel zum Hosentraeger: Buero- und Rohdateien haben auf der Seite nichts
# verloren, egal in welchem Ordner sie liegen.
<FilesMatch "\.(docx?|xlsx?|pptx?|pages|numbers|psd|ai|sketch|zip|rar|7z|tar|gz)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Verzeichnisse ohne index-Datei nicht auflisten.
Options -Indexes
